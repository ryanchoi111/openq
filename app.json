{
  "expo": {
    "name": "OpenQ",
    "slug": "openq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": [
      "openq",
      "com.googleusercontent.apps.736200593752-hgdr13cnbu30m2irh15j9vu3aqhau55f"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.openqapp.openq",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "OpenQ uses the camera to take profile photos and scan property tour QR codes.",
        "NSPhotoLibraryUsageDescription": "OpenQ uses your photo library when you choose a profile photo or property-related upload.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.openqapp.openq"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "OpenQ uses the camera to scan property tour QR codes.", "recordAudioAndroid": false }],
      "expo-font"
    ],
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "2f8daf62-e547-43c1-8b7d-e93c4d38a2a2"
      }
    },
    "owner": "openq-app"
  }
}
